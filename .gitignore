## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono Auto Generated Files
mono_crash.*

# Build results
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Rider / JetBrains
.idea/
*.sln.iml

# Visual Studio 2019/2022 cache/options directory
.vs/
.vscode/

# Backup & report files
*_i.c
*_p.c
*_h.h
*.ilk
*.meta
*.obj
*.pch
*.pdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*.log
*.vsidx
*.db

# Others
*.cache
*.diff
*.patch
*.orig
*.rej
*.exe
*.dll
*.pdb
*.mdb
*.bak
*.backup
*.swp
*.DS_Store
Thumbs.db

# NuGet
*.nupkg
*.snupkg
*.nuspec
project.lock.json
project.fragment.lock.json
artifacts/

# dotnet build artifacts
*.deps.json
*.runtimeconfig.json
*.runtimeconfig.dev.json
*.xml
*.doc.xml

# Paket dependency manager
.paket/
paket-files/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# StyleCop
StyleCopReport.xml

# Files built by Visual Studio
*_i.c
*_p.c
*_h.h
*.idb
*.opendb
*.tlog

# TFS
$tf/

# Azure
*.azurePubxml
*.publishsettings
*.pubxml
*.pubxml.user
PublishProfiles/
*.azurePubxml
*.pubxml

# Others
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# dotCover
.idea/.idea.*
*.dotCover

# NCrunch
_NCrunch_*
.*crunch*.local.xml
nCrunchTemp_*

# Web stuff
node_modules/
bower_components/
wwwroot/lib/

# Docker
*.pid
*.seed
*.pid.lock

# VS Code
.history/
.ionide/
